//Entrada: num; como entero
//Salida:(2, 4 , 6, 8 ...hasta 20)
//Proceso:
Algoritmo Numero_2_2_Hasta_20
	// Se define la variable
	Definir num Como Entero
	//Muestra el primer valor a trabajar 
	num = 2
	Escribir num 
	//Suma dos al valor inicial hasta llegar a 20 
	Mientras num < 20 Hacer
		num = num + 2
	Escribir num
	FinMientras
	
FinAlgoritmo
